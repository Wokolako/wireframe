// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  name                String
  phone               String               @unique
  password_hash       String
  role                String
  sms_opt_in          Int                  @default(0)
  sms_opt_in_at       String?
  created_at          String
  clerk_identity      ClerkIdentity?
  pwa_account         PwaAccount?
  farmer_profile      FarmerProfile?
  order_requests      OrderRequest[]
  bulk_order_requests BulkOrderRequest[]
  permissions         UserPermission[]
  verifications       ListingVerification[]
  sessions            Session[]
  sms_consents        SmsConsent[]
  conversational_state ConversationalState?

  @@map("users")
}

model ClerkIdentity {
  clerk_user_id String @id
  user_id       String @unique
  user          User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("clerk_identities")
}

model PwaVisitor {
  id           String  @id
  first_seen_at String
  last_seen_at  String
  prompted_at   String?
  dismissed_at  String?
  installed_at  String?

  @@map("pwa_visitors")
}

model PwaAccount {
  user_id      String  @id
  prompted_at  String?
  dismissed_at String?
  installed_at String?
  user         User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("pwa_accounts")
}

model FarmerProfile {
  id                  String              @id @default(uuid())
  user_id             String              @unique
  farm_name           String
  country             String              @default("")
  country_code        String              @default("")
  region_key          String              @default("")
  location_key        String              @default("")
  region              String              @default("")
  district            String?
  locality            String              @default("")
  ward                String?
  location            String              @default("")
  farm_size           Float               @default(0)
  verification_status String              @default("Unverified")
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  financial_estimate  FinancialEstimate?
  historical_baseline HistoricalBaseline?
  listings            Listing[]
  listing_draft       ListingDraft?

  @@map("farmer_profiles")
}

model HistoricalBaseline {
  farmer_id             String        @id
  crop_type             String?
  avg_land_size         Float?
  avg_yield_per_acre    Float?
  avg_duration_days     Int?
  status                String        @default("draft")
  updated_at            String
  farmer                FarmerProfile @relation(fields: [farmer_id], references: [id], onDelete: Cascade)

  @@map("historical_baselines")
}

model Listing {
  id                String         @id @default(uuid())
  farmer_id         String
  title             String
  crop_category     String
  available_volume  Float
  sale_unit         String         @default("kg")
  price             Float
  harvest_date      String
  expiration_date   String
  shelf_life_days   Int
  preservative_used Int            @default(0)
  description       String         @default("")
  image             String
  traceability      String         @default("")
  agent_score       Float          @default(0)
  status            String         @default("published")
  created_at        String
  farmer            FarmerProfile  @relation(fields: [farmer_id], references: [id], onDelete: Cascade)
  verification      ListingVerification?
  order_requests    OrderRequest[]
  guest_orders       GuestOrder[]

  @@index([crop_category, harvest_date], map: "listings_category_idx")
  @@map("listings")
}

model OrderRequest {
  id                String  @id @default(uuid())
  listing_id        String
  buyer_id          String
  volume            Float
  delivery_location String
  notes             String
  status            String  @default("New")
  created_at        String
  listing           Listing @relation(fields: [listing_id], references: [id], onDelete: Cascade)
  buyer             User    @relation(fields: [buyer_id], references: [id], onDelete: Cascade)

  @@index([buyer_id], map: "orders_buyer_idx")
  @@map("order_requests")
}

model Session {
  token_hash String @id
  user_id    String
  expires_at String
  user       User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model SmsConsent {
  id          String @id @default(uuid())
  user_id     String
  opted_in    Int
  recorded_at String
  source      String
  user        User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sms_consents")
}

model ConversationalState {
  user_phone          String  @id
  current_form_id     String?
  last_question_asked String?
  timestamp           String
  user                User    @relation(fields: [user_phone], references: [phone], onDelete: Cascade)

  @@map("conversational_state")
}

model SmsMessage {
  message_sid String @id
  received_at String

  @@map("sms_messages")
}

model ListingDraft {
  farmer_id  String        @id
  payload    String
  updated_at String
  farmer     FarmerProfile @relation(fields: [farmer_id], references: [id], onDelete: Cascade)

  @@map("listing_drafts")
}

model FinancialEstimate {
  farmer_id String @id
  cost_fertilizer_seeds Decimal?
  cost_labor Decimal?
  cost_processing Decimal?
  cost_transportation Decimal?
  avg_production_cost Decimal @default(0)
  legacy_total Decimal?
  country_code String
  region String
  locality String
  region_key String
  location_key String
  currency String
  status String @default("draft")
  updated_at String
  farmer FarmerProfile @relation(fields: [farmer_id], references: [id])
  @@map("financial_estimates")
}
model UserPermission {
  user_id String
  permission String
  user User @relation(fields: [user_id], references: [id])
  @@id([user_id, permission])
  @@map("user_permissions")
}
model ListingVerification {
  listing_id String @id
  agent_id String
  crop_confirmed Int @default(0)
  volume_confirmed Int @default(0)
  location_confirmed Int @default(0)
  harvest_confirmed Int @default(0)
  notes String @default("")
  score Int?
  status String @default("pending")
  updated_at String
  listing Listing @relation(fields: [listing_id], references: [id])
  agent User @relation(fields: [agent_id], references: [id])
  @@map("listing_verifications")
}

model GuestOrder {
  id String @id
  listing_id String
  quantity Float
  quantity_unit String @default("kg")
  payment_method String @default("pay_on_delivery")
  payment_status String @default("unpaid")
  unit_price Float?
  currency String?
  paid_at String?
  contact_name String
  contact_phone String
  contact_email String
  delivery_location String
  notes String @default("")
  status String @default("New")
  created_at String
  listing Listing @relation(fields: [listing_id], references: [id])
  @@map("guest_orders")
}

model BulkOrderRequest {
  id String @id
  buyer_id String
  frequency String
  produce_type String
  target_quantity Float
  quantity_unit String
  delivery_dates String
  target_price Float
  contact_name String
  contact_phone String
  contact_email String
  notes String @default("")
  status String @default("New")
  created_at String
  buyer User @relation(fields: [buyer_id], references: [id])
  @@map("bulk_order_requests")
}
