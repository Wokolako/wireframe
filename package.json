{
  "name": "wirefen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "concurrently -k \"npm:start:web\" \"npm:start:api\"",
    "start:web": "next start --hostname 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:pwa": "node tests/pwa-ui.mjs",
    "test:currency-ui": "node tests/currency-ui.mjs",
    "dev:full": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "preview": "next start --hostname 127.0.0.1",
    "start:api": "node --env-file-if-exists=.env server/index.mjs",
    "test:presentation": "node tests/presentation-ui.mjs",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@fontsource/dm-sans": "^5.2.6",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.4.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "twilio": "^5.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.45",
    "@prisma/config": "^7.10.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "playwright": "^1.55.0",
    "prisma": "^7.10.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
