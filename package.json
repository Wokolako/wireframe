{
  "name": "wirefen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:pwa": "node tests/pwa-ui.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@fontsource/dm-sans": "^5.2.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "twilio": "^5.10.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.55.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
