PORT=3001
APP_ORIGIN=http://localhost:5173
# Clerk sign-in (configure both keys; secret is server-only).
# The API provides the public key at runtime so all clients use the same instance.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Legacy phone/password and demo sign-in are disabled when Clerk is configured.
# In production, APP_ORIGIN must list the exact HTTPS application origins, comma-separated.
# Set PostgreSQL for deployment; otherwise local SQLite is used.
# DATABASE_URL=postgresql://user:password@localhost:5432/wirefen
# NODE_ENV=production
# SEED_DEMO=false
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_URL=https://your-domain/api/v1/webhooks/sms/receive
# MARKET_NAME=Your launch market
# CURRENCY=ZAR

# Container hosting / reverse proxy (set exact topology, not arbitrary trust):
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
# POSTGRES_PASSWORD=use-a-long-url-safe-random-password
