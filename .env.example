# Live mode serves the Next.js app and API from one Node server, with Neon PostgreSQL.
# Configure DATABASE_URL before starting the app. No SQLite fallback is used in live mode.
NEXT_PUBLIC_USE_BACKEND=true
USE_BACKEND=true
DATABASE_DRIVER=neon
SEED_DEMO=false

PORT=3000
APP_ORIGIN=http://localhost:3000
# Clerk sign-in (configure both keys; secret is server-only).
# The API provides the public key at runtime so all clients use the same instance.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# Static deployments use the provided public development key unless overridden.
# Legacy phone/password and demo sign-in are disabled when Clerk is configured.
# In production, APP_ORIGIN must list the exact HTTPS application origins, comma-separated.
# Set the Neon pooled URL for the live backend. Never commit a real credential.
# DATABASE_URL="postgresql://neondb_owner:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# NODE_ENV=production
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_URL=https://your-domain/api/v1/webhooks/sms/receive
# USSD_WEBHOOK_SECRET=configure-a-long-random-shared-secret-with-your-ussd-provider
# MARKET_NAME=Your launch market
# CURRENCY=ZAR
# For Malawi PayChangu, set MARKET_NAME=Malawi and CURRENCY=MWK.
# PayChangu mobile-money checkout is offered only when secret credentials and MWK are configured.
# PAYCHANGU_SECRET_KEY=
# PAYCHANGU_WEBHOOK_SECRET=
# Use only with PayChangu sandbox credentials in a non-production test environment.
# PAYCHANGU_TEST_MODE=false
# If an existing listing has no stored currency, set this once to that price's actual currency before running migrations.
# LEGACY_PRICE_CURRENCY=ZAR

# Container hosting / reverse proxy (set exact topology, not arbitrary trust):
# HOST=0.0.0.0
# TRUST_PROXY_HOPS=1
# POSTGRES_PASSWORD=use-a-long-url-safe-random-password
# DATABASE_RUNTIME_USER=wirefen_runtime
# DATABASE_RUNTIME_PASSWORD=use-at-least-24-url-safe-characters
